 "sources": [
  {
   "key": "A",
   "kind": "course",
   "title": "CS223A - Introduction to Robotics",
   "by": "Oussama Khatib, Stanford University (Stanford Engineering Everywhere)",
   "year": 2008,
   "url": "https://see.stanford.edu/Course/CS223A",
   "toc_urls": [
    "https://see.stanford.edu/Course/CS223A"
   ],
   "why": "节点“现有英文学习资源”就是这门课（免费视频 + 讲义 + 作业）。课程页把 16 讲按讲列出 Topics，并按讲义分成 Kinematics-1/2、Jacobian、Robots and Vision、Trajectory Planning、Dynamics、Control 几个单元，覆盖本节点的运动学、动力学、轨迹规划、机器人控制与视觉感知。"
  },
  {
   "key": "B",
   "kind": "course",
   "title": "Robot Mapping (WS 2022/23)",
   "by": "Tim Welschehold, Daniel Büscher, Lukas Luft, University of Freiburg",
   "year": 2022,
   "url": "http://ais.informatik.uni-freiburg.de/teaching/ws22/mapping",
   "toc_urls": [
    "http://ais.informatik.uni-freiburg.de/teaching/ws22/mapping"
   ],
   "why": "补“定位建图”和“感知融合”的概率部分（CS223A 只讲到立体视觉与跟踪，没有 SLAM）：这是弗赖堡大学 Robot Mapping 课的官方课表，逐讲列出 Bayes 滤波、EKF/UKF/EIF、EKF SLAM、粒子滤波定位、占据栅格、最小二乘与图优化 SLAM、前端配准，是 SLAM 最经典的一套教学顺序（沿 Stachniss 的课程）。"
  }
 ],

 "id": "V.2.3",
 "sources": [
  {
   "key": "A",
   "kind": "docs",
   "title": "Tutorials | Web Accessibility Initiative (WAI)",
   "by": "W3C Web Accessibility Initiative",
   "year": 2026,
   "url": "https://www.w3.org/WAI/tutorials/",
   "toc_urls": [
    "https://www.w3.org/WAI/tutorials/"
   ],
   "why": "节点现有的英文资源就是这个官方教程集，页面本身就是一份体系化目录：6 个组件教程（页面结构、菜单、图像、表格、表单、轮播），每个教程下再分若干主题页（如 Images 的 Informative/Decorative/Functional…、Forms 的 Labeling Controls/Validating Input…），对应“可感知、可操作”的具体设计做法，权威且免费。"
  },
  {
   "key": "B",
   "kind": "docs",
   "title": "How People with Disabilities Use the Web",
   "by": "W3C Web Accessibility Initiative (editor: Shadi Abou-Zahra)",
   "year": 2024,
   "url": "https://www.w3.org/WAI/people-use-web/",
   "toc_urls": [
    "https://www.w3.org/WAI/people-use-web/"
   ],
   "why": "补“多种能力和设备条件、辅助技术”：WAI 教程按网页组件组织，不讲使用者能力差异与辅助技术；这份 WAI 官方资源分 Diverse Abilities and Barriers（听觉、认知与学习、肢体、言语、视觉）与 Tools and Techniques（感知、呈现、输入、交互）两部分，正对这两点。"
  },
  {
   "key": "C",
   "kind": "docs",
   "title": "Easy Checks – A First Review of Web Accessibility",
   "by": "W3C Web Accessibility Initiative (editors: Kevin White, Andrew Arch, Shawn Lawton Henry)",
   "year": 2024,
   "url": "https://www.w3.org/WAI/test-evaluate/easy-checks/",
   "toc_urls": [
    "https://www.w3.org/WAI/test-evaluate/easy-checks/"
   ],
   "why": "补“设计评估”：WAI 官方的一线可达性自查清单，按 Common Checks / Audio/Visual Checks / Form Checks 三类列出具体检查项（替代文本、标题、对比度、键盘焦点、字幕、表单标签等），是设计完成后最直接的自评入口。"
  }
 ],

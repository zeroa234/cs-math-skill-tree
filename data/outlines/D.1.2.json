 "coverage": [
  {
   "topic": "索引",
   "refs": [
    "A:#07",
    "A:#08",
    "A:#09",
    "A:#10"
   ],
   "note": "第 7 讲 Hash Tables：数据结构选型、哈希表的两部分（哈希函数与哈希方案）、静态哈希（线性探查、Robin Hood、Cuckoo）与动态哈希（链式、可扩展、线性哈希）；第 8 讲 Indexes & Filters I：B+ 树的组织与设计选择（节点大小、合并阈值、变长键、结点内查找）、指针 swizzling 与前缀压缩等；第 9 讲 Indexes & Filters II：布隆过滤器、跳表、字典树、倒排索引、向量索引；第 10 讲 Index Concurrency Control：闩锁与 crabbing。"
  },
  {
   "topic": "执行计划",
   "refs": [
    "A:#11",
    "A:#13",
    "A:#14",
    "A:#15"
   ],
   "note": "第 11 讲 Sorting & Aggregations Algorithms 从“查询计划是算子树/DAG”讲起（1 Query Plan），再讲外排与聚合算子；第 13 讲 Joins Algorithms 把连接算子拆成嵌套循环/排序归并/哈希三类并给出 I/O 代价；第 14 讲 Query Execution I 讲处理模型（迭代器/物化/向量化）、访问方法、修改类查询与表达式求值；第 15 讲 Query Execution II 讲并行执行（查询间/查询内/I/O 并行）与进程模型。"
  },
  {
   "topic": "代价模型",
   "refs": [
    "A:#16",
    "A:#17"
   ],
   "note": "第 16 讲 Query Planning & Optimization I 的小节直接对应：5 Cost-Based Query Optimization、6 Cost Estimations、7 Search Termination、9 Single-Relation Query Plans、10 Multi-Relation Query Plans、11 System R 自底向上、12 Volcano 自顶向下；第 17 讲 Query Planning & Optimization II 进一步讲 2 Data Statistics（直方图、选择率估计）与 3 Cost Estimations。"
  },
  {
   "topic": "并发控制",
   "refs": [
    "A:#18",
    "A:#19",
    "A:#20",
    "A:#21"
   ],
   "note": "第 18 讲 Concurrency Control Theory：事务与 ACID 四条性质逐条展开（4–7 小节），并给出可串行化与冲突可串行化；第 19 讲 2PL：事务锁、两阶段锁、死锁处理、锁粒度与工程实践；第 20 讲时间戳排序：OCC、幻读问题与隔离级别；第 21 讲 MVCC：版本存储、垃圾回收、索引管理、删除四个设计考量。"
  },
  {
   "topic": "日志与恢复",
   "refs": [
    "A:#22",
    "A:#23"
   ],
   "note": "第 22 讲 Database Logging 从崩溃恢复的目标讲起，依次是缓冲池管理策略（STEAL/FORCE 组合）、影子分页、日志文件、WAL、日志记录方案与检查点；第 23 讲 Database Recovery 讲 WAL 记录格式、正常执行、检查点与 ARIES 恢复（分析/重做/撤销）。"
  }
 ],
 "omitted": "A（CMU 15-445 Fall 2026 schedule）未收：第 1 讲 Relational Model & Algebra、第 2 讲 Modern SQL（属 D.1.1 数据建模/关系模型与 SQL）、第 3–6 讲 Database Storage / Memory Management / Storage Models & Compression（存储引擎与存储布局，属大数据与存储布局相关节点）、第 12 讲与第 25 讲 DRC（论文研讨课，无固定主题）、第 24 讲 Distributed Databases（属 D.1.3 分布式数据库）；Mid-Term Exam、Fall Break、Thanksgiving 等无课日期也不算目录条目。小节层面未收的：第 #13 讲的 6 Conclusion（纯总结）、第 #09 讲 7 Optimizations 后的无编号小标题（PDF 里是“Partial Indexes”一类行内标题，不是编号小节）、第 #17 讲 PDF 里被抽取成“1 Multi-Relation !ery Plans”的乱码标题（正文里写的是“Multi-Relation query plans”，仍按正文标题收在分支里）。",
 "notes": "本轮（deepen-6）做法：按第一轮说明的第 1 种方式加深——用同一门课的官方 lecture notes PDF 把每讲拆到节。两点需要主代理知道：(1) Fall 2026 的 notes 只发到第 15 讲（#15 Query Execution II），第 16–23 讲的 notes 与 slides 在课表上还是空的，所以这些讲的节标题取自同一门课 Fall 2025 版的 notes（讲次编号差 1：#16↔fall2025/15-optimization1.pdf 起，逐讲到 #23↔fall2025/22-recovery.pdf），Fall 2025 的课表主题与 Fall 2026 一一对应、内容同源，故并入同一个来源 A 的 toc_urls。(2) 分支的 ref 用课表上的讲次编号（#07…#23），节标题的 ref 用 notes PDF 里的原始编号（1、2、4.1…）；由于不同讲的节编号重复，coverage 一律引用讲次分支（A:#17 这类），不引用节编号。",
